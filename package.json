{
  "name": "jellystream",
  "version": "3.0.0",
  "description": "Jellystream — desktop client for Jellyfin media servers",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "icon": "electron tools/make-icon.js",
    "dist": "electron-builder --win --publish never",
    "test": "npm run test:syntax && npm run test:core && npm run test:workflow && npm run test:downloads && npm run test:ui && npm run test:rows && npm run test:hero && npm run test:cards && npm run test:ux && npm run test:tvmode && npm run test:shapes && npm run test:libraries && npm run test:libsync && npm run test:servers && npm run test:vault && npm run test:login && npm run test:profiles && npm run test:playback && npm run test:syncplay && npm run test:segments && npm run test:livetv && npm run test:upcoming && npm run test:music && npm run test:i18n && npm run test:i18n:keys && npm run test:sync && npm run test:updater && npm run test:fixes && npm run test:mobile && npm run test:www && npm run test:web && npm run test:smoke",
    "test:syntax": "node --check main.js && node --check updater.js && node --check discord.js && node --check downloads.js && node --check languages.js && node --check core/i18n.js && node --check core/libraries.js && node --check core/livetv.js && node --check core/libsync.js && node --check core/vault.js && node --check core/trakt.js && node --check core/syncplay.js && node --check i18n-dom.js && node --check core/playback.js && node --check renderer.js && node --check views/cardmenu.js && node --check views/calendar.js && node --check views/livetv.js && node --check views/music.js && node --check views/stats.js && node --check offline.js && node --check player.js && node --check syncplay-ui.js && node --check settings.js && node --check profiles.js && node --check tvmode.js && node --check preload.js && node tools/scan-renderer-helpers.js",
    "test:downloads": "electron tools/test-downloads.js",
    "test:ui": "electron tools/test-ui.js",
    "test:rows": "electron tools/test-rows.js",
    "test:cards": "electron tools/test-cards.js",
    "test:i18n": "electron tools/test-i18n.js",
    "test:sync": "electron tools/test-sync.js",
    "test:libraries": "electron tools/test-libraries.js",
    "test:servers": "electron tools/test-servers.js",
    "test:segments": "electron tools/test-segments.js",
    "test:shapes": "electron tools/test-shapes.js",
    "test:livetv": "electron tools/test-livetv.js",
    "test:libsync": "electron tools/test-libsync.js",
    "test:smoke": "electron tools/smoke.js",
    "release": "electron-builder --win --publish always",
    "test:updater": "electron tools/test-updater.js",
    "test:playback": "electron tools/test-playback.js",
    "test:login": "electron tools/test-login.js",
    "test:fixes": "electron tools/test-fixes.js",
    "build": "electron-builder --publish never",
    "test:workflow": "node tools/test-workflow.js",
    "test:core": "node tools/test-core.js",
    "test:mobile": "electron tools/test-mobile.js",
    "mobile:build": "node tools/build-mobile.js",
    "mobile:sync": "npm run mobile:build && cap sync android",
    "test:www": "electron tools/test-www.js",
    "test:web": "electron tools/test-web.js",
    "web:build": "node tools/build-web.js",
    "version": "npm run web:build && npm run mobile:build && git add web android/app/build.gradle",
    "test:music": "electron tools/test-music.js",
    "test:hero": "electron tools/test-hero.js",
    "test:vault": "electron tools/test-vault.js",
    "test:i18n:keys": "node tools/missing-keys.js",
    "test:ux": "electron tools/test-ux.js",
    "test:profiles": "electron tools/test-profiles.js",
    "test:syncplay": "electron tools/test-syncplay.js",
    "test:upcoming": "electron tools/test-upcoming.js",
    "test:tvmode": "electron tools/test-tvmode.js"
  },
  "homepage": "https://github.com/jellystream-app/jellystream",
  "repository": {
    "type": "git",
    "url": "https://github.com/jellystream-app/jellystream.git"
  },
  "keywords": [
    "jellyfin",
    "electron",
    "streaming",
    "media"
  ],
  "author": {
    "name": "UkY",
    "email": "jellystream-app@users.noreply.github.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "js-yaml": "^4.3.2"
  },
  "build": {
    "appId": "com.jellystream.app",
    "productName": "Jellystream",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "downloads.js",
      "languages.js",
      "updater.js",
      "discord.js",
      "preload.js",
      "core/i18n.js",
      "i18n-dom.js",
      "core/playback.js",
      "renderer.js",
      "views/**",
      "offline.js",
      "player.js",
      "syncplay-ui.js",
      "settings.js",
      "profiles.js",
      "tvmode.js",
      "index.html",
      "audit.html",
      "styles.css",
      "styles/**",
      "logo.svg",
      "fonts/**",
      "build/icon.ico",
      "build/icon.png",
      "build/icons/**",
      "mobile/**",
      "core/**"
    ],
    "extraResources": [
      {
        "from": "language",
        "to": "language",
        "filter": [
          "**/*.json"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jellystream-app",
        "repo": "jellystream"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Jellystream",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "flatpak",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "synopsis": "Desktop client for Jellyfin media servers",
      "description": "Jellystream streams films, series and music from a Jellyfin server, with offline downloads and translations.",
      "desktop": {
        "entry": {
          "Name": "Jellystream",
          "Categories": "AudioVideo;Video;Player;Network;"
        }
      },
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "24.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "24.08",
      "license": "LICENSE",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "finishArgs": [
        "--share=network",
        "--share=ipc",
        "--socket=x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--device=dri",
        "--filesystem=xdg-download",
        "--filesystem=xdg-videos",
        "--filesystem=xdg-music",
        "--talk-name=org.freedesktop.ScreenSaver",
        "--talk-name=org.freedesktop.Notifications"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
